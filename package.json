{
  "name": "envguard",
  "version": "1.0.0",
  "description": "Zero-config CLI for .env synchronization, type validation, secret scanning, and automatic Markdown documentation.",
  "type": "module",
  "bin": {
    "envguard": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "env",
    "dotenv",
    "envguard",
    "security",
    "secret-scanner",
    "cli",
    "validation"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
